  "chave_consentimento": "trk_consent_v1",
  "pagina": { "lp_name": "nome_da_lp", "lp_version": "v1" },

  "gtm_id": "GTM-XXXXXXX",
  "ga4_id": "G-XXXXXXXXXX",

  "google_ads": {
    "conversion_id": "",
    "conversoes": [
      { "nome": "Pedido de orçamento", "evento": "click_quote_request", "rotulo": "" },
      { "nome": "Clique no WhatsApp", "evento": "click_whatsapp", "rotulo": "" },
      { "nome": "Clique no telefone", "evento": "click_phone", "rotulo": "" },
      { "nome": "Formulário enviado", "evento": "generate_lead", "rotulo": "" }
    ]
  },

  "meta": {
    "pixel_id": "",
